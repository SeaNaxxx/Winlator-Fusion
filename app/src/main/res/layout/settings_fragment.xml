<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout style="@style/FieldSet">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/cursor_speed"/>

                    <com.winlator.fusion.widget.SeekBar
                        android:id="@+id/SBCursorSpeed"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:suffix="%"
                        app:minValue="10"
                        app:maxValue="200" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="8dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/cursor_size"/>

                            <com.winlator.fusion.widget.SeekBar
                                android:id="@+id/SBCursorSize"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                app:suffix="%"
                                app:step="5"
                                app:minValue="100"
                                app:maxValue="200" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginLeft="8dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/color" />

                            <com.winlator.fusion.widget.ColorPickerView
                                android:id="@+id/CPVCursorColor"
                                android:layout_width="84dp"
                                android:layout_height="wrap_content" />
                        </LinearLayout>
                    </LinearLayout>

                    <View style="@style/FieldSeparator" />

                    <CheckBox
                        android:id="@+id/CBMoveCursorToTouchpoint"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/move_cursor_to_touchpoint" />

                    <CheckBox
                        android:id="@+id/CBCapturePointerOnExternalMouse"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/capture_pointer_on_external_mouse"
                        android:layout_marginTop="8dp" />

                    <CheckBox
                        android:id="@+id/CBHighRefreshRateMode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/high_refresh_rate_mode"
                        android:layout_marginTop="8dp" />

                    <CheckBox
                        android:id="@+id/CBCursorLock"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/cursor_lock"
                        android:layout_marginTop="8dp" />
                </LinearLayout>

                <TextView
                    style="@style/FieldSetLabel"
                    android:text="@string/mouse" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout style="@style/FieldSet">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/preferred_input_api" />

                    <Spinner
                        style="@style/ComboBox"
                        android:id="@+id/SPreferredInputApi"
                        android:layout_width="match_parent"
                        android:entries="@array/preferred_input_api_entries" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/player"
                            android:layout_marginRight="8dp" />

                        <LinearLayout
                            style="@style/Toolbox">

                            <LinearLayout
                                android:id="@+id/LLGamepadPlayer"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">

                                <ImageView
                                    style="@style/ListMenuButton"
                                    android:layout_width="40dp"
                                    android:layout_height="40dp"
                                    android:src="@drawable/gamepad_player_1" />

                                <ImageView
                                    style="@style/ListMenuButton"
                                    android:layout_width="40dp"
                                    android:layout_height="40dp"
                                    android:src="@drawable/gamepad_player_2" />

                                <ImageView
                                    style="@style/ListMenuButton"
                                    android:layout_width="40dp"
                                    android:layout_height="40dp"
                                    android:src="@drawable/gamepad_player_3" />

                                <ImageView
                                    style="@style/ListMenuButton"
                                    android:layout_width="40dp"
                                    android:layout_height="40dp"
                                    android:src="@drawable/gamepad_player_4" />
                            </LinearLayout>

                            <View style="@style/VerticalLine" />

                            <ImageView
                                android:id="@+id/BTResetGamepadPlayerConfigs"
                                style="@style/ListMenuButton"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:src="@drawable/icon_reset" />
                        </LinearLayout>
                    </LinearLayout>

                    <CheckBox
                        android:id="@+id/CBXinputToggle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/xinput_toggle"
                        android:layout_marginTop="8dp" />
                </LinearLayout>

                <TextView
                    style="@style/FieldSetLabel"
                    android:text="@string/game_controllers" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout style="@style/FieldSet">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/midi_input_device" />

                    <Spinner
                        style="@style/ComboBox"
                        android:id="@+id/SMIDIInputDevice"
                        android:layout_width="match_parent" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/midi_soundfont" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <Spinner
                            style="@style/ComboBox"
                            android:id="@+id/SSoundFont"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1" />

                        <LinearLayout
                            style="@style/Toolbox"
                            android:id="@+id/SoundFontToolbox">

                            <ImageButton
                                android:id="@+id/BTSoundFontTest"
                                style="@style/ListMenuButton"
                                android:src="@drawable/icon_piano" />

                            <ImageButton
                                style="@style/ListMenuButton"
                                android:src="@drawable/icon_install"
                                android:tag="install" />

                            <ImageButton
                                style="@style/ListMenuButton"
                                android:layout_marginRight="0dp"
                                android:src="@drawable/icon_remove"
                                android:tag="remove" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    style="@style/FieldSetLabel"
                    android:text="@string/sound" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout style="@style/FieldSet">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/box64_preset" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <Spinner
                            style="@style/ComboBox"
                            android:id="@+id/SBox64Preset"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1" />

                        <LinearLayout style="@style/Toolbox">
                            <ImageButton
                                style="@style/ListMenuButton"
                                android:id="@+id/BTAddBox64Preset"
                                android:src="@drawable/icon_add" />

                            <ImageButton
                                style="@style/ListMenuButton"
                                android:id="@+id/BTEditBox64Preset"
                                android:src="@drawable/icon_edit" />

                            <ImageButton
                                style="@style/ListMenuButton"
                                android:id="@+id/BTDuplicateBox64Preset"
                                android:src="@drawable/icon_duplicate" />

                            <ImageButton
                                style="@style/ListMenuButton"
                                android:id="@+id/BTRemoveBox64Preset"
                                android:src="@drawable/icon_remove" />

                            <ImageButton
                                style="@style/ListMenuButton"
                                android:id="@+id/BTExportBox64Preset"
                                android:src="@drawable/icon_export" />

                            <ImageButton
                                style="@style/ListMenuButton"
                                android:id="@+id/BTImportBox64Preset"
                                android:layout_marginRight="0dp"
                                android:src="@drawable/icon_install" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    style="@style/FieldSetLabel"
                    android:text="@string/box64" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout style="@style/FieldSet">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/fexcore_preset" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <Spinner
                            style="@style/ComboBox"
                            android:id="@+id/SFEXCorePreset"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1" />

                        <LinearLayout style="@style/Toolbox">
                            <ImageButton
                                style="@style/ListMenuButton"
                                android:id="@+id/BTAddFEXCorePreset"
                                android:src="@drawable/icon_add" />

                            <ImageButton
                                style="@style/ListMenuButton"
                                android:id="@+id/BTEditFEXCorePreset"
                                android:src="@drawable/icon_edit" />

                            <ImageButton
                                style="@style/ListMenuButton"
                                android:id="@+id/BTDuplicateFEXCorePreset"
                                android:src="@drawable/icon_duplicate" />

                            <ImageButton
                                style="@style/ListMenuButton"
                                android:id="@+id/BTRemoveFEXCorePreset"
                                android:src="@drawable/icon_remove" />

                            <ImageButton
                                style="@style/ListMenuButton"
                                android:id="@+id/BTExportFEXCorePreset"
                                android:src="@drawable/icon_export" />

                            <ImageButton
                                style="@style/ListMenuButton"
                                android:id="@+id/BTImportFEXCorePreset"
                                android:layout_marginRight="0dp"
                                android:src="@drawable/icon_install" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    style="@style/FieldSetLabel"
                    android:text="@string/fexcore" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout style="@style/FieldSet">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/language" />

                    <Spinner
                        style="@style/ComboBox"
                        android:id="@+id/SLanguage"
                        android:layout_width="match_parent"
                        android:entries="@array/language_entries" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/theme" />

                    <RadioGroup
                        android:id="@+id/RGAppTheme"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <RadioButton
                            android:id="@+id/RBLight"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/light" />

                        <RadioButton
                            android:id="@+id/RBDark"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/dark" />
                    </RadioGroup>

                    <CheckBox
                        android:id="@+id/CBDarkMode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/dark_mode"
                        android:layout_marginTop="8dp" />

                    <CheckBox
                        android:id="@+id/CBEnableBigPictureMode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/enable_big_picture_mode"
                        android:layout_marginTop="8dp" />

                    <CheckBox
                        android:id="@+id/CBEnableCustomApiKey"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/enable_custom_api_key"
                        android:layout_marginTop="8dp" />

                    <EditText
                        style="@style/EditText"
                        android:id="@+id/ETCustomApiKey"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/custom_api_key"
                        android:inputType="textNoSuggestions|textVisiblePassword"
                        android:visibility="gone" />

                    <ImageView
                        android:id="@+id/BTHelpApiKey"
                        style="@style/HelpButton" />

                    <CheckBox
                        android:id="@+id/CBOpenAndroidBrowserFromWine"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/open_android_browser_from_wine"
                        android:layout_marginTop="8dp" />

                    <CheckBox
                        android:id="@+id/CBUseAndroidClipboardOnWine"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/use_android_clipboard_on_Wine"
                        android:layout_marginTop="8dp" />

                    <CheckBox
                        android:id="@+id/CBOpenWithAndroidBrowser"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/open_with_android_browser"
                        android:layout_marginTop="8dp" />

                    <CheckBox
                        android:id="@+id/CBShareAndroidClipboard"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/share_android_clipboard"
                        android:layout_marginTop="8dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <CheckBox
                            android:id="@+id/CBEnableFileProvider"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/enable_file_provider" />

                        <ImageView
                            android:id="@+id/BTHelpFileProvider"
                            style="@style/HelpButton" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    style="@style/FieldSetLabel"
                    android:text="@string/system" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout style="@style/FieldSet">
                    <CheckBox
                        android:id="@+id/CBEnableWineDebug"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/enable_wine_debug" />

                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <LinearLayout
                            android:id="@+id/LLWineDebugChannels"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:padding="4dp" />
                    </HorizontalScrollView>

                    <View style="@style/FieldSeparator" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/box64_logs" />

                    <Spinner
                        style="@style/ComboBox"
                        android:id="@+id/SBox64Logs"
                        android:layout_width="match_parent"
                        android:entries="@array/box64_logs" />

                    <CheckBox
                        android:id="@+id/CBEnableBox64Logs"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/enable_box64_logs"
                        android:layout_marginTop="8dp" />

                    <CheckBox
                        android:id="@+id/CBSaveLogsToFile"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="@string/save_logs_to_file"
                        android:layout_marginTop="8dp" />

                    <EditText
                        android:id="@+id/ETLogFile"
                        style="@style/EditText"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:visibility="gone" />

                    <LinearLayout
                        android:id="@+id/LLWineInstallation"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <View style="@style/FieldSeparator" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/wine_version" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <Spinner
                                style="@style/ComboBox"
                                android:id="@+id/SWineVersion"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1" />

                            <LinearLayout style="@style/Toolbox">
                                <ImageButton
                                    style="@style/ListMenuButton"
                                    android:id="@+id/BTInstallWine"
                                    android:src="@drawable/icon_install" />

                                <ImageButton
                                    style="@style/ListMenuButton"
                                    android:id="@+id/BTRemoveWine"
                                    android:layout_marginRight="0dp"
                                    android:src="@drawable/icon_remove" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>

                    <CheckBox
                        android:id="@+id/CBUseDRI3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/use_dri3"
                        android:layout_marginTop="8dp" />

                    <CheckBox
                        android:id="@+id/CBUseXR"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/use_xr"
                        android:layout_marginTop="8dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/winlator_path" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/TVWinlatorPath"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="/storage/emulated/0/Winlator" />

                        <Button
                            style="@style/ButtonNeutral"
                            android:id="@+id/BTChooseWinlatorPath"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/choose" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/shortcut_export_path" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/TVShortcutExportPath"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1" />

                        <Button
                            style="@style/ButtonNeutral"
                            android:id="@+id/BTChooseShortcutExportPath"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/choose" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/downloadable_contents_url" />

                    <EditText
                        style="@style/EditText"
                        android:id="@+id/ETDownloadableContentsURL"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textUri" />

                    <View style="@style/FieldSeparator" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_horizontal">

                        <Button
                            style="@style/ButtonNeutral"
                            android:id="@+id/BTReinstallSystemFiles"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_horizontal"
                            android:text="@string/reinstall_system_files" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    style="@style/FieldSetLabel"
                    android:text="@string/advanced" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">

                <LinearLayout style="@style/FieldSet">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/backup_and_restore" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <Button
                            style="@style/ButtonNeutral"
                            android:id="@+id/BTBackupData"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="@string/backup_data" />

                        <Button
                            style="@style/ButtonNeutral"
                            android:id="@+id/BTRestoreData"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="@string/restore_data" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    style="@style/FieldSetLabel"
                    android:text="@string/backup_and_restore" />
            </FrameLayout>
        </LinearLayout>
    </ScrollView>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/BTConfirm"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="right|bottom"
        app:tint="#ffffff"
        android:src="@drawable/icon_confirm"
        android:layout_margin="16dp" />
</FrameLayout>
